<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} | %-5p | %class | %msg%n</pattern>
        </encoder>
    </appender>
    <appender name="STDOUT_SERVICES" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%red %d{yyyy-MM-dd HH:mm:ss} | %-5p | %class | %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>
    <logger name="org.mantagar.web.userevents.post" level="INFO">
        <appender-ref ref="STDOUT_SERVICES" />
    </logger>
    <logger name="org.mantagar.web.userevents.user" level="INFO">
        <appender-ref ref="STDOUT_SERVICES" />
    </logger>
</configuration>